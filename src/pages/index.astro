---
import BaseLayout from '../layouts/BaseLayout.astro';
import SocialLinks from '../components/SocialLinks.astro';
import { site } from '../data/site';
---

<BaseLayout>
  <section class="hero">
    <div>
      <h1>{site.name}</h1>
      <p class="meta-line">{site.title} · {site.lab}</p>
      <p class="meta-line">{site.affiliation}</p>
      <p class="meta-line">{site.address}</p>
      <p class="meta-line">
        <a href={`mailto:${site.email}`}>{site.email}</a>
      </p>
      <SocialLinks />
    </div>
    <img
      class="hero-photo"
      src={site.profileImage}
      alt={`Portrait of ${site.name}`}
      width="168"
      height="168"
    />
  </section>

  <h2>About</h2>
  {site.bio.map((paragraph) => <p>{paragraph}</p>)}

  <h2>Research Interests</h2>
  <ul class="list-plain">
    {site.interests.map((item) => <li>{item}</li>)}
  </ul>

  <h2>Education</h2>
  <ul class="list-plain">
    {
      site.education.map((item) => (
        <li>
          <strong>{item.degree}</strong>, {item.school} ({item.year})
        </li>
      ))
    }
  </ul>

  <h2>Awards</h2>
  <ul class="list-plain">
    {site.awards.map((item) => <li>{item}</li>)}
  </ul>
</BaseLayout>
